# Public deployment host used by Caddy.
PUBLIC_DOMAIN=downloads.example.com

# Build-time browser API base for the frontend image.
# "/" means the browser calls the same origin and Caddy routes API paths to Nest.
NEXT_PUBLIC_API_BASE_URL=/

NODE_ENV=production
PORT=3000

# CORS should match the public frontend origin.
FRONTEND_ORIGIN=https://downloads.example.com

# Supabase/Postgres and local Redis container.
DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres
REDIS_URL=redis://redis:6379

QUEUE_NAME=video-queue
WORKER_CONCURRENCY=2

SESSION_COOKIE_NAME=sessionId
SESSION_COOKIE_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=true

SESSION_MAX_JOBS=5
SESSION_WINDOW_SECONDS=600
SESSION_MAX_BYTES=500000000
MAX_FILE_BYTES=1000000000
MAX_STORAGE_BYTES=10000000000

FILE_TTL_SECONDS=3600
SIGNED_URL_TTL_SECONDS=900
PROCESSING_STALE_AFTER_SECONDS=21600
ENABLE_NEW_REQUESTS=true

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=video-downloads
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

YTDLP_BINARY_PATH=
FFMPEG_BINARY_PATH=
