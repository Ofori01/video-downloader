# Host port bound only on localhost for nginx reverse proxy.
BACKEND_HOST_PORT=3100

# Optional for image-pull deployments. GitHub Actions writes these to
# .env.images on the VPS, so production .env.vps normally does not need them.
BACKEND_API_IMAGE=ghcr.io/ofori01/video-downloader-backend-api:latest
BACKEND_WORKER_IMAGE=ghcr.io/ofori01/video-downloader-backend-worker:latest

NODE_ENV=production
PORT=3000

# Vercel/custom frontend origin. Update after the frontend domain is configured.
FRONTEND_ORIGIN=https://downloads.mertonpharmacy.com

# Supabase/Postgres and app-private Docker Redis.
DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres
REDIS_URL=redis://redis:6379

QUEUE_NAME=video-queue
WORKER_CONCURRENCY=1

SESSION_COOKIE_NAME=sessionId
SESSION_COOKIE_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=true

SESSION_MAX_JOBS=3
SESSION_WINDOW_SECONDS=600
SESSION_MAX_BYTES=500000000
MAX_FILE_BYTES=500000000
MAX_STORAGE_BYTES=3000000000

FILE_TTL_SECONDS=3600
SIGNED_URL_TTL_SECONDS=900
PROCESSING_STALE_AFTER_SECONDS=21600
ENABLE_NEW_REQUESTS=true

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=video-downloads
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# Docker worker images set these paths in compose. Set them manually only for
# non-Docker worker runtimes.
YTDLP_BINARY_PATH=
FFMPEG_BINARY_PATH=
