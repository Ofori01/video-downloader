NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001,http://localhost:3100

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_downloader
REDIS_URL=redis://localhost:6379

QUEUE_NAME=video-queue
WORKER_CONCURRENCY=3

SESSION_COOKIE_NAME=sessionId
SESSION_COOKIE_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false

SESSION_MAX_JOBS=5
SESSION_WINDOW_SECONDS=600
SESSION_MAX_BYTES=500000000
MAX_FILE_BYTES=1000000000
MAX_STORAGE_BYTES=10000000000

FILE_TTL_SECONDS=3600
SIGNED_URL_TTL_SECONDS=900
PROCESSING_STALE_AFTER_SECONDS=21600
SOURCE_PROFILE_CACHE_TTL_SECONDS=600
INSTAGRAM_COOLDOWN_SECONDS=1800
INSTAGRAM_SOURCE_LOCK_TTL_SECONDS=1800
INSTAGRAM_YTDLP_SLEEP_REQUESTS_SECONDS=1.5
INSTAGRAM_YTDLP_RETRY_SLEEP=extractor:exp=30:300
ENABLE_NEW_REQUESTS=true

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=video-downloads
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-key

# Leave blank to resolve yt-dlp from PATH. Set FFMPEG_BINARY_PATH for local
# merged video downloads.
YTDLP_BINARY_PATH=
FFMPEG_BINARY_PATH=
